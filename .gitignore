.DS_Store

# 本地密钥：只提交 .env.example
.env
.env.*
!.env.example
# 由 .env 转换来的内置默认配置，含 Key，不进 git
DongKe/Resources/ai-defaults.json

DerivedData/
.build/
*.xcresult
xcuserdata/
*.xcuserstate
.scratch/*/assets/

# 图标探索的预览图，9MB，结论已落进 AppIcon 与 HANDOFF §6.24
.scratch/icon-explore/

# Everkinetic 原始 raster 库：27MB 的离线参考，不是 App 资源
# 用法与许可风险见 docs/FIGURE-STYLE.md §6
everkinetic-data/

# 音条原型：由 macOS `say` 渲染，仅内部试听，不能随包上架
VoiceClips/*.wav
VoiceClips/*.txt

# 离线 TTS 复现用的本地环境：venv 约 2.5GB、权重 2.3GB，都不进 git
# 复现步骤见 .scratch/offline-tts/README.md §6d
.scratch/*/.venv/
.scratch/*/assets-generated/
.scratch/*/model/
.scratch/*/model-*/
build/
